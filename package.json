{
  "name": "shein-coupon-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Discovery and legitimate validation service for publicly published SHEIN India coupons and promotions.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan:once": "RUN_ONCE=true node dist/index.js",
    "report": "REPORT_ONLY=true node dist/index.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "mongoose": "^8.6.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
