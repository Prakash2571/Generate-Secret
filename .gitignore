# Never commit real credentials
.env
.env.*
!.env.example

node_modules/
dist/
dist-test/
*.tsbuildinfo

# Compiled output must never sit next to the TypeScript sources
src/**/*.js
tests/**/*.js

# Generated reports (directory itself is kept via results/.gitkeep)
results/*
!results/.gitkeep

logs/
*.log
npm-debug.log*
coverage/
.DS_Store
.idea/
.vscode/
playwright-report/
test-results/
