# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local MongoDB shipped with docker-compose (service name = mongodb):
MONGODB_URL=mongodb://mongodb:27017
# External MongoDB Atlas (no source change required, just replace the URL):
# MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/
MONGODB_DB=shein_coupon_finder

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
SCAN_INTERVAL_MINUTES=30
VALIDATION_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Request safety (be conservative, this is a polite crawler)
# ---------------------------------------------------------------------------
MAX_CONCURRENT_REQUESTS=3
REQUEST_DELAY_MS=2000

# ---------------------------------------------------------------------------
# Target offer used for ranking (~80% off: 800 off a 1000 cart)
# ---------------------------------------------------------------------------
TARGET_CART_VALUE=1000
TARGET_DISCOUNT=800

NODE_ENV=production

# ---------------------------------------------------------------------------
# Optional tuning (all values below are optional and have sane defaults)
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error
# LOG_LEVEL=info
# Run a single discovery+validation cycle, print the report, then exit.
# RUN_ONCE=false
# Print the report from MongoDB without scanning, then exit.
# REPORT_ONLY=false

# Freshness thresholds (hours)
# REVALIDATE_VALID_AFTER_HOURS=24
# REVALIDATE_UNVERIFIED_AFTER_HOURS=6
# REVALIDATE_INVALID_AFTER_HOURS=72
# STALE_SOURCE_AFTER_DAYS=30

# Networking / crawling
# REQUEST_TIMEOUT_MS=20000
# MAX_RETRIES=2
# USER_AGENT=SheinCouponFinder/1.0 (+public coupon research; contact: you@example.com)

# Playwright / cart validation
# HEADLESS=true
# BROWSER_TIMEOUT_MS=45000
# ENABLE_CART_VALIDATION=true
# MAX_CART_VALIDATIONS_PER_CYCLE=5

# Discovery limits
# MAX_CANDIDATES_PER_COLLECTOR=60
# MAX_VALIDATIONS_PER_CYCLE=40

# Reports
# RESULTS_DIR=/app/results
# SHUTDOWN_TIMEOUT_MS=25000
